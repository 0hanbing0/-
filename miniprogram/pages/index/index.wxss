/* ══════════════════════════════
   Variables & Base
   ══════════════════════════════ */

page {
  background: #1a241a;
  color: #e0d8c8;
  font-size: 28rpx;
}


.container {
  max-width: 100%;
  padding: 20rpx;
}

/* Header */
.header {
  text-align: center;
  padding: 48rpx 0 32rpx;
  border-bottom: 1rpx solid #3a4a3a;
  margin-bottom: 40rpx;
}
.h-title {
  font-size: 52rpx;
  letter-spacing: 4rpx;
  color: #d4a843;
  display: block;
  font-weight: bold;
}
.subtitle {
  font-size: 26rpx;
  color: #988e7e;
  margin-top: 8rpx;
  display: block;
}

/* Settings */
.settings {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  background: #222922;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  border: 1rpx solid #3a4a3a;
}
.s-label {
  font-size: 26rpx;
  color: #988e7e;
  white-space: nowrap;
}
.s-input {
  background: #1a241a;
  color: #e0d8c8;
  border: 1rpx solid #3a4a3a;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 26rpx;
  width: 120rpx;
  text-align: center;
}
.s-input-wide {
  width: 150rpx;
}
.s-input-small {
  width: 100rpx;
}
.s-sep {
  color: #3a4a3a;
  font-size: 36rpx;
  margin: 0 8rpx;
}
.riichi-points {
  color: #5fc07a;
  font-weight: bold;
  font-size: 26rpx;
}
.uma-picker {
  display: inline-block;
}
.picker-text {
  font-size: 24rpx;
  padding: 6rpx 10rpx;
  background: #1a241a;
  border: 1rpx solid #3a4a3a;
  border-radius: 8rpx;
  color: #e0d8c8;
}
.custom-uma {
  display: flex;
  gap: 6rpx;
}
.dealer-select {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.dealer-radio {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
}
.kiriage-label {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #988e7e;
}

/* Player Cards */
.players {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.player-card {
  background: #222922;
  border: 3rpx solid #3a4a3a;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  text-align: center;
}
.player-card.dealer {
  border-color: #e8a040;
  border-width: 4rpx;
  background: linear-gradient(135deg, #2a2218 0%, #322010 100%);
  box-shadow: 0 0 28rpx rgba(232, 160, 64, 0.3);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.dealer-badge {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  background: #c04020;
  color: #ffe0c0;
  font-size: 22rpx;
  font-weight: bold;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 0 12rpx rgba(200, 100, 40, 0.5);
}

.name-input {
  display: block;
  width: 100%;
  text-align: center;
  background: transparent;
  border: none;
  border-bottom: 1rpx dashed #3a4a3a;
  color: #e0d8c8;
  font-size: 30rpx;
  padding: 8rpx 0;
  margin: 12rpx 0;
  outline: none;
}

.score-input {
  display: block;
  width: 100%;
  text-align: center;
  background: #1a241a;
  border: 1rpx solid #3a4a3a;
  border-radius: 8rpx;
  color: #5fc07a;
  font-size: 44rpx;
  font-weight: bold;
  padding: 12rpx 8rpx;
  font-family: 'Courier New', monospace;
  outline: none;
}

.rank-display {
  font-size: 26rpx;
  margin-top: 12rpx;
  font-weight: bold;
}
.rank-1-text { color: #d4a843; }
.rank-2-text { color: #8899aa; }
.rank-3-text { color: #a07040; }
.rank-4-text { color: #707070; }

/* Results Section */
.results-section {
  background: #222922;
  border: 1rpx solid #3a4a3a;
  border-radius: 20rpx;
  overflow: hidden;
}
.results-title {
  font-size: 32rpx;
  padding: 28rpx 40rpx;
  background: #252d25;
  border-bottom: 1rpx solid #3a4a3a;
  color: #d4a843;
  letter-spacing: 4rpx;
}
.player-result {
  border-bottom: 1rpx solid #3a4a3a;
  padding: 32rpx 40rpx;
}
.player-result-last {
  border-bottom: none;
}

/* Player result header */
.pr-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}
.pr-wind {
  font-size: 34rpx;
  font-weight: bold;
}
.pr-name {
  font-size: 30rpx;
}
.pr-score {
  font-family: 'Courier New', monospace;
  font-size: 32rpx;
  color: #5fc07a;
  font-weight: bold;
}
.pr-rank {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-weight: bold;
}
.pr-dealer {
  color: #e0a060;
  font-size: 22rpx;
}
.rank-badge-1 { background: #3a3020; color: #d4a843; }
.rank-badge-2 { background: #282c30; color: #8899aa; }
.rank-badge-3 { background: #2a2218; color: #a07040; }
.rank-badge-4 { background: #242424; color: #707070; }

.no-reversal {
  color: #4a9e5e;
  font-size: 26rpx;
}

/* Reversal table — view-based */
.rt-header {
  display: flex;
  background: #1a1f1a;
  border-bottom: 2rpx solid #3a4a3a;
}
.rt-th {
  padding: 16rpx 10rpx;
  font-size: 24rpx;
  color: #988e7e;
}
.rt-row {
  display: flex;
  border-bottom: 1rpx solid #1a1f1a;
}
.rt-td {
  padding: 16rpx 10rpx;
}

.target-name {
  font-weight: bold;
  font-size: 28rpx;
}
.gap-value {
  font-family: 'Courier New', monospace;
  color: #c05050;
  font-weight: bold;
}

.hand-value {
  font-family: 'Courier New', monospace;
  font-weight: bold;
  font-size: 30rpx;
  display: block;
}
.hand-desc {
  font-size: 24rpx;
  color: #988e7e;
  display: block;
}
.impossible {
  color: #c05050;
  font-weight: bold;
}
.easy-reversal {
  color: #5fc07a;
}

/* Footer */
.footer {
  text-align: center;
  padding: 40rpx;
  color: #988e7e;
  font-size: 22rpx;
  line-height: 1.6;
}
